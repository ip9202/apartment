# 아이뜨락 아파트 커뮤니티 - 환경 변수 템플릿
# 복사 후 .env.local 로 저장하여 실제 값을 채우세요: cp .env.example .env.local

# PostgreSQL 연결 문자열 (로컬 개발)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aitteulak

# 테스트 전용 DB (마이그레이션/시드 테스트용)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aitteulak_test

# Access Token 서명 키 (32자 이상 랜덤). 생성: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-char-random-secret

# Refresh Token 서명 키 (JWT_SECRET 과 상이, 32자 이상). 생성: openssl rand -hex 32
JWT_REFRESH_SECRET=replace-with-different-32-plus-char-random-secret

# 앱 URL (로컬: http://localhost:3000, 프로덕션: https://your-domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 첨부파일 저장소 루트 (SPEC-ATTACHMENT-001).
# 영구 볼륨(Railway Volume / VPS / Docker volume) 필수. Vercel(ephemeral filesystem) 비권장.
# 기본 ./public/uploads (미설정 시 attachments-storage.ts 가 사용).
ATTACHMENTS_DIR=./public/uploads

# 카카오 OAuth 2.0 소셜 로그인 (SPEC-AUTH-KAKAO-001)
# 카카오 개발자콘솔(https://developers.kakao.com)에서 앱 생성 후 발급.
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
